#include<iostream>
using namespace std;

class Stack
{
	public:
		int size;
		int arr[10];
		int popvalue;

	Stack(){
			size = -1;
		}

	void push(int value){
		if(size == 9){
			cout<< "The stack is full"<< endl;
			}
		else{
			size++;
			arr[size] = value;
			}
		}

	int pop(){
		if(size == -1){
			cout<< "The stack is empty nothing to pop"<< endl;
			}
		else{
			popvalue = arr[size];
			size--;
			}
		return popvalue;
		}

	void display(){
		for(int i=0;i<=size;i++){
			cout<<i+1<<":"<<arr[i]<<endl;
			}
		}
};

int main(){
Stack st;
st.push(10);
st.push(20);
st.push(30);
st.display();
cout<<"Stack after poping"<<endl;
st.pop();
st.display();
return 0;
}
